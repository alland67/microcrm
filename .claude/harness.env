# ---------------------------------------------------------------
# Harness configuration for MicroCRM (ASP.NET Core .NET 10 + React/TS)
# Single source of truth for commands and path boundaries.
# All commands run from the repository root.
# ---------------------------------------------------------------

# Full suites
BACKEND_TEST_CMD="dotnet test --solution MicroCrm.slnx"   # MTP mode (global.json): solution must use --solution
FRONTEND_TEST_CMD="npm --prefix web test"
TEST_CMD="$BACKEND_TEST_CMD && $FRONTEND_TEST_CMD"

# Single test / file ({target} is replaced)
#   backend : a test class name fragment, e.g. ContactsEndpoints  (xUnit v3 on MTP: --filter-class / --filter-method,
#             wildcards allowed; the VSTest-style --filter "FullyQualifiedName~X" does NOT work)
#   frontend: a file path or name fragment, e.g. ContactForm
TEST_ONE_BACKEND_CMD="dotnet test --solution MicroCrm.slnx --filter-class \"*{target}*\""
TEST_ONE_BACKEND_METHOD_CMD="dotnet test --solution MicroCrm.slnx --filter-method \"*{target}*\""
TEST_ONE_FRONTEND_CMD="npm --prefix web test -- {target}"
TEST_ONE_CMD="$TEST_ONE_BACKEND_CMD"   # default; use the frontend variant for web/ tests

# Quality gates
LINT_CMD="dotnet format MicroCrm.slnx --verify-no-changes --no-restore && npm --prefix web run lint"
TYPECHECK_CMD="npm --prefix web run typecheck"
BUILD_CMD="dotnet build MicroCrm.slnx --nologo && npm --prefix web run build"
FORMAT_CMD="scripts/format-file.sh"   # dispatches by extension (.cs -> dotnet format, web/* -> prettier)

# EF Core migrations ({name} is replaced, PascalCase, e.g. CreateContacts).
# Available once spec 001 T-02 adds the dotnet-ef local tool manifest (.config/dotnet-tools.json).
MIGRATIONS_ADD_CMD="dotnet tool restore && dotnet ef migrations add {name} --project src/MicroCrm.Api --output-dir Data/Migrations"

# Dev servers (for humans / e2e later)
DEV_API_CMD="dotnet run --project src/MicroCrm.Api --urls http://localhost:5080"
DEV_WEB_CMD="npm --prefix web run dev"

# Path globs (space-separated, relative to repo root; * also matches across folders)
SOURCE_GLOBS="src/* web/src/*"
TEST_GLOBS="tests/* web/src/*.test.ts web/src/*.test.tsx web/src/*.spec.ts web/src/*.spec.tsx web/src/test/* web/e2e/*"

# Role write-boundaries (enforced by .claude/hooks/path-guard.sh)
PLANNER_WRITABLE="specs/* docs/adr/* docs/architecture.md docs/roadmap.md .claude/harness.env"
TEST_WRITER_WRITABLE="$TEST_GLOBS"
IMPLEMENTER_PROTECTED="$TEST_GLOBS specs/* docs/constitution.md docs/conventions.md"
REVIEWER_WRITABLE="specs/*/review.md"
DOCUMENTER_WRITABLE="docs/* *.md CHANGELOG* README*"

# Files no agent may edit directly
PROTECTED_GLOBS=".env .env.* */.env */.env.* *.pem *.key *.p12 .git/* */.git/* global.json"

# Stop gate: when 1, Claude can't end a turn with uncommitted changes and a failing TEST_CMD
STOP_GATE="0"

# Commit after each task passes review (1) or leave commits to you (0)
COMMIT_PER_TASK="0"
