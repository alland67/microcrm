# Port matches DEV_API_CMD in .claude/harness.env (dotnet run ... --urls http://localhost:5080)
@MicroCrm.Api_HostAddress = http://localhost:5080

### Create a contact; the PUT and DELETE below use its id
# @name createContact
POST {{MicroCrm.Api_HostAddress}}/api/contacts
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada@example.com"
}

###

PUT {{MicroCrm.Api_HostAddress}}/api/contacts/{{createContact.response.body.$.id}}
Content-Type: application/json

{
  "firstName": "Ada",
  "lastName": "Lovelace",
  "email": "ada@example.com",
  "phone": null,
  "company": "Analytical Engines",
  "notes": null
}

###

DELETE {{MicroCrm.Api_HostAddress}}/api/contacts/{{createContact.response.body.$.id}}

###

# @name createTodo
POST {{MicroCrm.Api_HostAddress}}/api/todos
Content-Type: application/json

{
  "title": "Call Ada",
  "notes": "About the quote",
  "dueDate": "2026-10-05"
}

###

GET {{MicroCrm.Api_HostAddress}}/api/todos/{{createTodo.response.body.$.id}}

###

PUT {{MicroCrm.Api_HostAddress}}/api/todos/{{createTodo.response.body.$.id}}
Content-Type: application/json

{
  "title": "Call Ada back",
  "notes": null,
  "dueDate": "2026-10-06",
  "contactId": null
}

###

POST {{MicroCrm.Api_HostAddress}}/api/todos/{{createTodo.response.body.$.id}}/complete

###

POST {{MicroCrm.Api_HostAddress}}/api/todos/{{createTodo.response.body.$.id}}/reopen

###

DELETE {{MicroCrm.Api_HostAddress}}/api/todos/{{createTodo.response.body.$.id}}
